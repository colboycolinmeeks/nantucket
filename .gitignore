# Build outputs
/nantucket
/dbase
/xbase
/dist/
coverage.out
coverage.html

# Data and output files created by running programs from the repo root
# (make run, make example, the dot prompt). Anchored to the root so that
# test fixtures in subdirectories can still be committed.
/*.dbf
/*.dbt
/*.fpt
/*.ntx
/*.mem
/*.prn
/*.txt

# Printer output can land anywhere a program runs
*.prn

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Profiling output (go test -cpuprofile, nantucket -cpuprofile)
*.prof
*.test

# Internal review notes (regenerated by the app-review skill; not shared)
RECOMMENDATIONS*.md

# Personal notes kept beside the code
LINKEDIN.md
